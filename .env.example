# GitHub personal access token with public_repo (or repo) scope.
# Required: unauthenticated GitHub REST allows only 60 requests per hour.
VERIQUILL_GITHUB_TOKEN=ghp_yourtokenhere

# Everything below is optional. With none of it set, Veriquill runs fully
# deterministic: provenance, code evaluation, reconciliation and ranking never
# involve a model, and the same input always produces the same dossier.

# Key for the two optional model passes. Needs `pip install "veriquill[llm]"`.
# Leave empty to let the SDK resolve its own credentials instead.
# VERIQUILL_ANTHROPIC_API_KEY=sk-ant-yourkeyhere

# Phrase claims the structural resume parser missed. Only ever runs when a
# resume or LinkedIn export is attached, and only quotes text in the document.
# VERIQUILL_CLAIM_REFINEMENT_ENABLED=true

# Phrase design judgment static analysis cannot reach. Every observation must
# quote a real line, severity is capped at medium, and it never reports a number.
# VERIQUILL_CODE_REVIEW_ENABLED=true

# Who may call the API, as JSON mapping key to the identity it acts as. The
# identity is the name written into the audit log, so make it a real one.
#
# Left empty the server is open and every review action is signed with a name
# nobody verified. That is fine locally and must not be true anywhere shared.
# VERIQUILL_API_KEYS={"sk_change_me": "you@example.com"}
